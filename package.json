{
  "name": "fetch-resilience",
  "version": "0.1.0",
  "description": "Composable resilience policies (retry, timeout, circuit breaker, bulkhead) for native fetch — edge-safe, zero dependencies",
  "keywords": [
    "fetch",
    "retry",
    "circuit-breaker",
    "resilience",
    "timeout",
    "bulkhead",
    "edge"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "pretest": "tsc",
    "test": "node --experimental-transform-types --test tests/*.test.ts tests/package-artifact.test.mjs",
    "test:build": "tsc && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "ultracite": "7.10.2"
  }
}
